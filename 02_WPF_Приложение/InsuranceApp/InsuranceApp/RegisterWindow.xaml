<Window x:Class="InsuranceApp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="600" Width="450" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">

    <Border Background="#FFFFFF" CornerRadius="16" Margin="20" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#059669" Opacity="0.15" BlurRadius="40" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Button Click="BtnClose_Click" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,15,15,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <TextBlock Text="✕" Foreground="#9CA3AF" FontSize="16" FontWeight="Bold"/>
            </Button>

            <StackPanel Margin="40,30,40,20">
                <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                <TextBlock Text="Фамилия" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="#FFC9E4C1" CornerRadius="8" Margin="0,0,0,10" Padding="15,0,15,0">
                    <TextBox x:Name="TbFamiliya" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Имя" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="#FFC9E4C1" CornerRadius="8" Margin="0,0,0,10" Padding="15,0,15,0">
                    <TextBox x:Name="TbImya" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Отчество" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Background="#FFC9E4C1" CornerRadius="8" Margin="0,0,0,10" Padding="15,0,15,0">
                    <TextBox x:Name="TbOtchestvo" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Логин" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="#FFC9E4C1" CornerRadius="8" Margin="0,0,0,10" Padding="15,0,15,0">
                    <TextBox x:Name="TbLogin" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Пароль" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="#FFC9E4C1" CornerRadius="8" Margin="0,0,0,25" Padding="15,0,15,0">
                    <PasswordBox x:Name="PbPassword" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                </Border>

                <Button Click="BtnRegister_Click" Height="45" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#047857"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Зарегистрироваться" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>